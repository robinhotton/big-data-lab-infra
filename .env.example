# ─────────────────────────────────────────────────────────────────────────────
# Configuration du lab — lab local Docker, single-user (un formateur/apprenant).
# Copier ce fichier en .env (gitignored) et adapter si besoin.
# Valeurs de lab : OK pour un usage pédagogique local, JAMAIS en production.
# ─────────────────────────────────────────────────────────────────────────────

# Credentials admin MinIO (root) — un seul bucket data-lake.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Clé KMS locale MinIO — active le chiffrement SSE-S3 (AES256) sans service externe.
# Clé factice de lab (32 octets en base64). Ne pas réutiliser en production.
MINIO_KMS_SECRET_KEY=formation-key:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Base de données interne Airflow (Postgres 16, réseau lab-net, pas exposé sur l'hôte).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Credentials Airflow admin (crés au premier démarrage par airflow-init).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Skip le téléchargement du dataset taxi-full (~45 Mo, nécessite Internet).
# Mettre à true pour le Plan B réseau (lab offline).
SKIP_TAXI_FULL=false

# Profiles Docker Compose activés — "datasets" lance le chargement automatique
# des datasets au `docker compose up -d`. Retirer pour démarrer sans datasets.
COMPOSE_PROFILES=datasets
